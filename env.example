# Copia este archivo como ".env" y llena los valores reales.
# En local: export $(cat .env | xargs)  antes de "python app.py"
# En Render: se configuran directamente en el dashboard (Environment).

# --- Base de datos (Neon) ---
DATABASE_URL=postgresql://usuario:password@ep-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# --- Flask ---
FLASK_SECRET_KEY=cambia-esta-clave-por-una-generada-aleatoriamente

# --- SMTP (envío del resultado por correo, vía Brevo) ---
# IMPORTANTE: Render bloquea los puertos SMTP estándar (25, 465, 587) en el
# plan gratis. Se usa Brevo con el puerto 2525 (no bloqueado). A diferencia
# de Resend, Brevo SÍ permite mandar a cualquier destinatario (por ejemplo,
# a cada estudiante) solo verificando el correo remitente -- no necesitas
# tener un dominio propio con acceso a DNS.
#
#   1. Crea cuenta en https://brevo.com (gratis, 300 correos/día)
#   2. Ve a Senders, Domains & Dedicated IPs > Senders > Add a sender
#      y verifica el correo que vas a usar como remitente (con el link
#      que te llega a ese correo)
#   3. Ve a Transactional > Settings > SMTP & API > genera una "SMTP key"
#      (NO es la API key normal)
#
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_USER=tu_correo_de_cuenta_brevo@ejemplo.com
SMTP_PASSWORD=tu-smtp-key-de-brevo
SMTP_FROM_NAME=AlertaEdu CULagos
